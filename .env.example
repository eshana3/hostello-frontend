# URL of the backend API server (NOT the client's own URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public URL this client is deployed at — used for SEO metadata, canonical
# URLs, and the generated sitemap. Set to the real deployed domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Client ID (Web application) — from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

